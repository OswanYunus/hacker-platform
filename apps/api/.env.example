# Postgres connection used by Prisma
DATABASE_URL="postgresql://hacker:hacker_dev_password@localhost:5432/hacker?schema=public"

# Random 32+ char string — generate with `openssl rand -base64 48`
JWT_SECRET="replace-with-a-long-random-string-at-least-32-characters"

# 32 bytes, base64-encoded — generate with `openssl rand -base64 32`
# Used to encrypt stored secrets (test-account credentials, session
# cookies, bearer tokens, CI webhook tokens). Rotate via a KMS in
# production; see src/lib/crypto.ts.
MASTER_ENCRYPTION_KEY="replace-with-openssl-rand--base64-32-output"

# Origin(s) allowed to call the API with credentials (comma-separated)
WEB_ORIGIN="http://localhost:3000"
PUBLIC_APP_URL="http://localhost:3000"
RESEND_API_KEY=""
PASSWORD_RESET_EMAIL_FROM=""

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# How many scans the in-process queue runs concurrently (see
# src/services/scanQueue.ts). Keep low on small hosts — each scan issues
# real HTTP requests at the configured rate limit.
SCAN_WORKER_CONCURRENCY=2

# Not yet used by the app (see src/services/queue.redis.md) — present for
# when you enable the Redis-backed queue for multi-worker deployments.
REDIS_HOST="localhost"
REDIS_PORT=6379
